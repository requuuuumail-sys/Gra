<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_background">

    <!-- Game Surface View -->
    <com.zebuild.game.GameActivity$GameSurfaceView
        android:id="@+id/game_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Resource Display Panel -->
    <LinearLayout
        android:id="@+id/resource_panel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:background="#80000000"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- Gold Display -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_gold"
                android:contentDescription="Gold" />

            <TextView
                android:id="@+id/gold_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gold: 500"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- Elixir Display -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_elixir"
                android:contentDescription="Elixir" />

            <TextView
                android:id="@+id/elixir_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elixir: 300"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls Panel -->
    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#80000000"
        android:gravity="center"
        android:padding="8dp">

        <!-- Add Building Button -->
        <ImageButton
            android:id="@+id/btn_add_building"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_add_building"
            android:contentDescription="Add Building"
            android:scaleType="centerInside"
            android:layout_margin="8dp"
            android:background="@drawable/button_circle" />

        <!-- Upgrade Button -->
        <ImageButton
            android:id="@+id/btn_upgrade"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_upgrade"
            android:contentDescription="Upgrade"
            android:scaleType="centerInside"
            android:layout_margin="8dp"
            android:background="@drawable/button_circle" />

        <!-- Return Button -->
        <ImageButton
            android:id="@+id/btn_return"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back to Menu"
            android:scaleType="centerInside"
            android:layout_margin="8dp"
            android:background="@drawable/button_circle" />
    </LinearLayout>

</RelativeLayout>
