<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:id="@+id/gold_text" android:layout_width="wrap_content" android:layout_height="wrap_content" text="Złoto: 0" />
    <TextView android:id="@+id/elixir_text" android:layout_width="wrap_content" android:layout_height="wrap_content" text="Eliksir: 0" />

    <View
        android:id="@+id/game_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button android:id="@+id/btn_add_building" android:layout_width="wrap_content" android:layout_height="wrap_content" text="Dodaj Budynek" />
    <Button android:id="@+id/btn_upgrade" android:layout_width="wrap_content" android:layout_height="wrap_content" text="Ulepsz" />
    <Button android:id="@+id/btn_return" android:layout_width="wrap_content" android:layout_height="wrap_content" text="Powrót" />

</LinearLayout>
